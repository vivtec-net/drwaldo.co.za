---
import Meta from "../blocks/meta.astro";
import Link from "../blocks/link.astro";

const { pathname } = Astro.url;
const { title, description, image = `${import.meta.env.BASE_URL}images/placeholder.webp` } = Astro.props;
---

<html lang="en">
	<Meta title={title} description={description} image={image} />
	<body>
		<nav>
			<Link class="logo" href="">
				<img src={`${import.meta.env.BASE_URL}favicon.avif`} alt="logo" width="128" height="128" />
				<hgroup>
					<h1>Morvet Kleindiere</h1>
					<span>Dr. Waldo Rossouw</span>
				</hgroup>
			</Link>
			<ul role="list">
				<li role="listitem">
					<Link href="" aria-current={pathname === `${import.meta.env.BASE_URL}` ? "page" : "false"}> Home </Link>
				</li>
				<li role="listitem">
					<Link href="about/" aria-current={pathname === `${import.meta.env.BASE_URL}about/` ? "page" : "false"}>
						About
					</Link>
				</li>
				<li role="listitem">
					<Link href="contact/" aria-current={pathname === `${import.meta.env.BASE_URL}contact/` ? "page" : "false"}>
						Contact
					</Link>
				</li>
			</ul>
		</nav>
		<main>
			<slot />
		</main>
		<footer>Test</footer>
	</body>
</html>

<style>
	body {
		display: grid;
		grid:
			"head" auto
			"main" 200svb
			"foot" auto / 1fr;

		& > nav {
			grid-area: head;
		}
		& > main {
			grid-area: main;
		}
		& > footer {
			grid-area: foot;
		}
	}

	body {
		background: #f8f5f0;
	}

	nav {
		background: #f8f7f3;
		box-shadow: 0px 0px 3px 0 color-mix(in oklch, black, transparent 60%);
		display: flex;
		flex-flow: row wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 3rem;
		padding-inline: 2rem;

		& > .logo {
			display: flex;
			align-items: center;
			gap: 1em;

			& > img {
				inline-size: 100px;
				aspect-ratio: 1 / 1;
				border-radius: 50%;
			}

			& > hgroup {
				font-size: var(--fs-0);
				font-weight: bold;
				text-transform: uppercase;
			}
		}

		& > ul {
			display: flex;
			gap: 1em;
			padding-inline: 2rem;

			a {
				display: block;
				padding-inline: 1em;
				padding-block: 0.5em;
				background: var(--colorPri);
				border-radius: 0.5em;
				text-transform: uppercase;
				font-weight: bold;
			}
		}
	}
</style>
