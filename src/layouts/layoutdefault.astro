---
import Meta from "../blocks/meta.astro";
import Link from "../blocks/link.astro";

const { pathname } = Astro.url;
const { title, description, image = `${import.meta.env.BASE_URL}images/placeholder.webp` } = Astro.props;
---

<html lang="en">
	<Meta title={title} description={description} image={image} />
	<body>
		<nav>
			<div class="wrapper">
				<Link class="logo" href="">
					<img src={`${import.meta.env.BASE_URL}favicon.avif`} alt="logo" width="128" height="128" />
					<hgroup>
						<h1>Morvet Kleindiere</h1>
						<span>Dr. Waldo Rossouw</span>
					</hgroup>
				</Link>
				<ul role="list">
					<li role="listitem">
						<Link href="" aria-current={pathname === `${import.meta.env.BASE_URL}` ? "page" : "false"}> Home </Link>
					</li>
					<li role="listitem">
						<Link
							href="services/"
							aria-current={pathname === `${import.meta.env.BASE_URL}services/` ? "page" : "false"}
						>
							Services
						</Link>
					</li>
					<li role="listitem">
						<Link href="contact/" aria-current={pathname === `${import.meta.env.BASE_URL}contact/` ? "page" : "false"}>
							Contact
						</Link>
					</li>
				</ul>
			</div>
		</nav>
		<main>
			<slot />
		</main>
		<footer>Being developed by <strong><a href="https://vivtec.co.za" target="_blank">VIVTEC</a></strong></footer>
	</body>
</html>

<style>
	body {
		display: grid;
		grid:
			"head" auto
			"main" 1fr
			"foot" auto / 1fr;
		background:
			linear-gradient(-75deg, var(--colorPri), transparent), linear-gradient(-120deg, var(--colorPri), transparent);
		isolation: isolate;

		& > nav {
			grid-area: head;
		}
		& > main {
			grid-area: main;
		}
		& > footer {
			grid-area: foot;
		}
	}

	nav {
		position: sticky;
		inset: 0 0 auto 0;
		background: #f8f7f3;
		box-shadow: 0px 0px 6px 3px color-mix(in oklch, black, transparent 90%);
		z-index: 1;
		border-radius: 0 0px 20px 20px;
		overflow-x: clip;

		& > .wrapper {
			display: flex;
			flex-flow: row wrap;
			align-items: center;
			justify-content: space-between;
			gap: 1rem 3rem;
			inline-size: min(calc(100% - 2rem), 1340px);
			margin-inline: auto;
			overflow-x: clip;
		}

		.logo {
			display: flex;
			align-items: center;
			gap: 1em;

			img {
				inline-size: 100px;
				aspect-ratio: 1 / 1;
				border-radius: 50%;
			}

			hgroup {
				font-size: var(--fs-0);
				font-weight: bold;
				text-transform: uppercase;
			}
		}

		ul {
			display: flex;
			gap: 1em;
			padding-inline: 2rem;

			a {
				display: block;
				padding-inline: 1em;
				padding-block: 0.5em;
				background: var(--colorPri);
				border-radius: 0.5em;
				text-transform: uppercase;
				font-weight: bold;
			}
		}
	}
	main {
		display: grid;
		place-items: start stretch;
	}

	footer {
		display: grid;
		place-items: center;
		padding-inline: 1em;
		padding-block: 0.5em;
	}
</style>
